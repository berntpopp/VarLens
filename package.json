{
  "name": "varlens",
  "version": "0.74.0",
  "description": "Genetic variant analysis tool for external collaborators",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/berntpopp/VarLens",
  "author": "Bernt Popp <bernt.popp@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.11.0 <12"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:electron": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts && vite build --config vite.web-renderer.config.ts",
    "build:web:server": "vite build --config vite.web.config.ts",
    "build:web:renderer": "vite build --config vite.web-renderer.config.ts",
    "dev:web:renderer": "vite --config vite.web-renderer.config.ts",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --publish onTag",
    "dist:win": "electron-vite build && electron-builder --win --publish onTag",
    "dist:mac": "electron-vite build && electron-builder --mac --publish onTag",
    "dist:linux": "electron-vite build && electron-builder --linux --publish onTag",
    "postinstall": "node scripts/native/rebuild-native.mjs install",
    "rebuild:electron": "node scripts/native/rebuild-native.mjs electron",
    "rebuild:node": "node scripts/native/rebuild-native.mjs node",
    "lint": "eslint . --cache --cache-strategy content --concurrency=off --fix",
    "lint:check": "eslint . --no-cache --concurrency=off",
    "agent:check": "node scripts/check-agent-health.mjs",
    "format": "node scripts/format.mjs --write \"*.{js,cjs,mjs,ts,tsx,vue,json,css,scss,html,md,yml,yaml}\" \"{src,tests,scripts,.github}/**/*.{js,cjs,mjs,ts,tsx,vue,json,css,scss,html,md,yml,yaml}\" \".vscode/*.json\"",
    "format:check": "node scripts/format.mjs --check \"*.{js,cjs,mjs,ts,tsx,vue,json,css,scss,html,md,yml,yaml}\" \"{src,tests,scripts,.github}/**/*.{js,cjs,mjs,ts,tsx,vue,json,css,scss,html,md,yml,yaml}\" \".vscode/*.json\"",
    "test": "vitest run --project main --project renderer",
    "test:watch": "vitest --project main --project renderer",
    "test:coverage": "COVERAGE=1 vitest run --project main --project renderer --coverage",
    "test:web-gate": "vitest run --project web-gate",
    "test:web-smoke": "node tests/web-smoke/run-web-smoke.cjs run",
    "test:web-smoke:open": "node tests/web-smoke/run-web-smoke.cjs open",
    "test:ipc-parity-fixtures": "npx tsx scripts/ipc-parity/validate-fixtures.ts",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:node && npm run typecheck:web && npm run typecheck:contracts",
    "typecheck:renderer": "vue-tsc --noEmit -p tsconfig.renderer.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:contracts": "vitest run --project contract-typecheck",
    "icons:generate": "png2icons resources/icon@2x.png build/icon -icns -ico && cp build/icon.ico resources/icon.ico",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:screenshots": "npx playwright test tests/e2e/screenshots.e2e.ts",
    "build:gene-ref": "npx tsx scripts/build-gene-reference-db.ts",
    "simulate": "npx tsx scripts/simulate-variants.ts",
    "varlens:hash-password": "npx tsx scripts/varlens-hash-password.ts",
    "lint:quick": "eslint . --cache --cache-strategy content --concurrency=off"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/fuses": "^2.1.3",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.63.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3": "^7.4.3",
    "@types/file-saver": "^2.0.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/plotly.js": "^3.0.14",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "d3": "^7.9.0",
    "electron": "^43.7.7",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "file-saver": "^2.0.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.3",
    "lighthouse": "^13.5.0",
    "nock": "^14.0.17",
    "npm-run-all2": "^9.0.3",
    "pdbe-molstar": "^3.12.0",
    "pinia": "^4.0.3",
    "playwright": "^1.63.0",
    "plotly.js-basic-dist-min": "^4.0.0",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "sass-embedded": "^1.105.1",
    "tar": "^7.5.22",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.0",
    "vue-tsc": "^3.3.11",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.2.4"
  },
  "build": {
    "appId": "com.varlens.app",
    "productName": "Varlens",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "afterPack": "scripts/configure-fuses.mjs",
    "extraResources": [
      {
        "from": "resources/gene_reference.db",
        "to": "gene_reference.db"
      },
      {
        "from": "src/main/storage/postgres/migrations/sql",
        "to": "postgres-migrations"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "node_modules/better-sqlite3-multiple-ciphers/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "berntpopp",
      "repo": "varlens",
      "releaseType": "draft"
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.exe"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "category": "Science"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.4.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@node-rs/argon2": "^2.2.1",
    "adm-zip": "^0.6.1",
    "better-sqlite3-multiple-ciphers": "^12.11.1",
    "bottleneck": "^2.19.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jstat": "^1.9.6",
    "kysely": "^0.29.6",
    "markdown-it": "^15.0.2",
    "nanoid": "^6.0.1",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pg-query-stream": "^4.17.1",
    "piscina": "^5.3.2",
    "stream-json": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.2"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@xmldom/xmldom": "^0.8.15",
    "lodash": "^4.18.1",
    "@electron/fuses": "^2.1.3",
    "js-yaml": "^4.3.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "printWidth": 100,
    "endOfLine": "lf"
  }
}
