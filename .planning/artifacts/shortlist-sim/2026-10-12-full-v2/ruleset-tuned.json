{
  "version": 1,
  "id": "varvis-exome-tuned",
  "modes": [
    {
      "id": "ar_hom",
      "label": "Recessive, homozygous",
      "when": "moi:~:AR AND zygosity:=:hom",
      "points": 0
    },
    {
      "id": "ar_comphet",
      "label": "Recessive, possible compound heterozygous",
      "when": "moi:~:AR AND zygosity:=:het AND gene_het_hits:>=:2",
      "points": -4.5
    },
    {
      "id": "xl",
      "label": "X-linked",
      "when": "moi:~:X AND (zygosity:=:hemi OR zygosity:=:hom OR ((moi:~:XD OR moi:~:XLD) AND zygosity:=:het))",
      "points": -5
    },
    {
      "id": "ad",
      "label": "Dominant, heterozygous",
      "when": "moi:~:AD AND zygosity:=:het",
      "points": -6
    },
    {
      "id": "fallback",
      "label": "No compatible inheritance",
      "when": null,
      "points": -8
    }
  ],
  "groups": [
    {
      "id": "freq",
      "label": "Population frequency",
      "scope": "global",
      "rules": [
        {
          "id": "af_missing",
          "label": "Not in gnomAD",
          "when": "gnomad_af:is:null",
          "points": 0
        },
        {
          "id": "af_lt_1e5",
          "label": "AF < 0.001 %",
          "when": "gnomad_af:<:0.00001",
          "points": 1.5
        },
        {
          "id": "af_lt_1e4",
          "label": "AF 0.001–0.01 %",
          "when": "gnomad_af:>=:0.00001 AND gnomad_af:<:0.0001",
          "points": 1
        },
        {
          "id": "af_lt_1e3",
          "label": "AF 0.01–0.1 %",
          "when": "gnomad_af:>=:0.0001 AND gnomad_af:<:0.001",
          "points": -2
        },
        {
          "id": "af_ref",
          "label": "AF ≥ 0.1 % (reference)",
          "when": "gnomad_af:>=:0.001",
          "points": -6.5
        }
      ]
    },
    {
      "id": "effect",
      "label": "Variant effect",
      "scope": "global",
      "rules": [
        {
          "id": "lof",
          "label": "Loss of function",
          "when": "func:=:stop_gained OR func:=:frameshift_truncation OR func:=:frameshift_elongation OR func:=:frameshift_variant OR func:=:splice_acceptor_variant OR func:=:splice_donor_variant OR func:=:start_lost OR func:=:stop_lost",
          "points": 0
        },
        {
          "id": "missense",
          "label": "Missense",
          "when": "func:=:missense_variant",
          "points": -4.5
        },
        {
          "id": "inframe",
          "label": "In-frame indel",
          "when": "func:=:inframe_indel",
          "points": -8
        },
        {
          "id": "splice_region",
          "label": "Splice region",
          "when": "func:=:splice_region_variant",
          "points": -6.5
        },
        {
          "id": "mnv",
          "label": "Multi-nucleotide variant",
          "when": "func:=:mnv",
          "points": -8
        },
        {
          "id": "effect_ref",
          "label": "Other effect (reference)",
          "when": "func:is:notnull OR func:is:null",
          "points": -8
        }
      ]
    },
    {
      "id": "cadd",
      "label": "CADD",
      "scope": "global",
      "rules": [
        {
          "id": "cadd_30",
          "label": "CADD ≥ 30",
          "when": "cadd:>=:30",
          "points": 0
        },
        {
          "id": "cadd_25",
          "label": "CADD 25–30",
          "when": "cadd:>=:25 AND cadd:<:30",
          "points": -2.5
        },
        {
          "id": "cadd_20",
          "label": "CADD 20–25",
          "when": "cadd:>=:20 AND cadd:<:25",
          "points": -4
        },
        {
          "id": "cadd_15",
          "label": "CADD 15–20",
          "when": "cadd:>=:15 AND cadd:<:20",
          "points": -6
        },
        {
          "id": "cadd_ref",
          "label": "CADD < 15 or missing (reference)",
          "when": "cadd:<:15 OR cadd:is:null",
          "points": -8
        }
      ]
    },
    {
      "id": "clinvar",
      "label": "ClinVar",
      "scope": "global",
      "rules": [
        {
          "id": "clinvar_plp",
          "label": "ClinVar pathogenic / likely pathogenic",
          "when": "clinvar:=:Pathogenic OR clinvar:=:Likely_pathogenic OR clinvar:=:Pathogenic/Likely_pathogenic",
          "points": 8
        },
        {
          "id": "clinvar_conflict",
          "label": "ClinVar conflicting",
          "when": "clinvar:~:conflicting",
          "points": 1
        },
        {
          "id": "clinvar_vus",
          "label": "ClinVar VUS",
          "when": "clinvar:=:Uncertain_significance",
          "points": 1
        },
        {
          "id": "clinvar_blb",
          "label": "ClinVar benign / likely benign",
          "when": "clinvar:=:Benign OR clinvar:=:Likely_benign OR clinvar:=:Benign/Likely_benign",
          "points": -4
        },
        {
          "id": "clinvar_ref",
          "label": "No ClinVar assertion (reference)",
          "when": "clinvar:is:null OR clinvar:is:notnull",
          "points": 0
        }
      ]
    },
    {
      "id": "phenotype",
      "label": "Phenotype match",
      "scope": "global",
      "rules": [
        {
          "id": "hpo_15",
          "label": "HPO similarity ≥ 0.15",
          "when": "hpo_sim_score:>=:0.15",
          "points": 0
        },
        {
          "id": "hpo_10",
          "label": "HPO similarity 0.10–0.15",
          "when": "hpo_sim_score:>=:0.1 AND hpo_sim_score:<:0.15",
          "points": 0
        },
        {
          "id": "hpo_05",
          "label": "HPO similarity 0.05–0.10",
          "when": "hpo_sim_score:>=:0.05 AND hpo_sim_score:<:0.1",
          "points": 0
        },
        {
          "id": "hpo_gt0",
          "label": "HPO similarity > 0",
          "when": "hpo_sim_score:>:0 AND hpo_sim_score:<:0.05",
          "points": 0
        },
        {
          "id": "hpo_ref",
          "label": "No phenotype match (reference)",
          "when": "hpo_sim_score:is:null OR hpo_sim_score:<=:0",
          "points": -8
        }
      ]
    },
    {
      "id": "gene",
      "label": "Disease gene",
      "scope": "global",
      "rules": [
        {
          "id": "omim_gene",
          "label": "OMIM disease gene",
          "when": "omim_mim_number:is:notnull",
          "points": 0
        },
        {
          "id": "gene_ref",
          "label": "No OMIM link (reference)",
          "when": "omim_mim_number:is:null",
          "points": -8
        }
      ]
    },
    {
      "id": "ad_freq",
      "label": "Frequency for dominant",
      "scope": "ad",
      "rules": [
        {
          "id": "ad_af_high",
          "label": "Too common for dominant",
          "when": "gnomad_af:>:0.0001",
          "points": -8
        },
        {
          "id": "ad_af_ref",
          "label": "Plausible for dominant (reference)",
          "when": "gnomad_af:<=:0.0001 OR gnomad_af:is:null",
          "points": 0
        }
      ]
    }
  ],
  "sha256": "3d4ebc0049c3c80f4942ff7f8da4a7e8179ece746c0caabfabb17d915b8dc096"
}
