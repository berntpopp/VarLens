exports[`VariantFilterBuilder characterization (compiled SQL + parameters) > inheritance modes > inheritance trio autosomal_recessive with group 1`] = `
{
  "parameters": [
    2,
    7,
    2,
  ],
  "prepareError": null,
  "sql": "select "variants".*, CAST(vf.case_count AS REAL) / NULLIF((SELECT COUNT(*) FROM cases WHERE import_status = 'ready'), 0) as "internal_af" from "variants" left join "variant_frequency" as "vf" on "vf"."chr" = "variants"."chr" and "vf"."pos" = "variants"."pos" and "vf"."ref" = "variants"."ref" and "vf"."alt" = "variants"."alt" where "variants"."case_id" = ? and ((
            variants.gt_num IN ('1/1','1|1')
            AND variants.id NOT IN (
              SELECT p.id FROM variants p
              INNER JOIN analysis_group_members agm_par
                ON agm_par.group_id = ? AND agm_par.role IN ('father', 'mother')
              INNER JOIN variants par
                ON par.case_id = agm_par.case_id
                AND par.chr = p.chr AND par.pos = p.pos AND par.ref = p.ref AND par.alt = p.alt
                AND par.gt_num IN ('1/1','1|1')
              WHERE p.case_id = ?
            )
          ))",
}
`;

