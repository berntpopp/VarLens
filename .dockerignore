# Explicit web-build inputs only. Host native modules, secrets, docs and tests
# never enter the context or invalidate the web source layer.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig*.json
!vite.web.config.ts
!vite.web-renderer.config.ts
!src/
!src/**
!scripts/
!scripts/web/
!scripts/web/**
!resources/
!resources/gene_reference.db
